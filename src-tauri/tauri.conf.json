{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHIFT",
  "version": "0.1.0",
  "identifier": "com.yesu166.shift",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SHIFT",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Local-first document toolbox",
    "longDescription": "SHIFT compresses files into validated ZIP archives locally and will expand into a verified document toolbox."
  }
}
